config global
    option enabled '0'

config mqtt
    option topic_prefix 'eu868'
    option server 'tcp://localhost:1883'
    option qos '0'
 	option keep_alive_interval '30s'
 	option reconnect_interval '1s'

config filters

config concentratord
    option event_url 'ipc:///tmp/concentratord_slot2_event'
    option command_url 'ipc:///tmp/concentratord_slot2_command'

config callbacks 'callbacks'
